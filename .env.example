# Copiar a .env en el servidor. Nunca subir .env real al repositorio.
APP_PASSWORD=

# Opcional: habilita comprensión de conversación libre, transcripción mejorada y voz natural (servicios pagos)
OPENAI_API_KEY=
OPENAI_NLU_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Google Gemini: crear en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_NLU_MODEL=gemini-3.8-flash
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
